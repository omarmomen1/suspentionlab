# ── Builder stage ────────────────────────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast dependency resolution
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR="/usr/local/bin" sh

# Copy dependency files
COPY pyproject.toml ./
COPY src/ ./src/

# Create virtual environment and install ALL dependencies (core + prod extras)
RUN uv venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN uv pip install -e ".[prod]"

# ── Runtime stage ────────────────────────────────────────────────────────────
FROM python:3.11-slim

WORKDIR /app

# FIXED: Create a non-root user and group to run the application.
# Previously this container ran as root — a compromised container granted full
# root access within the container boundary, violating enterprise security baselines.
RUN groupadd --gid 1001 appgroup \
    && useradd --uid 1001 --gid appgroup --shell /bin/false --no-create-home appuser

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy application code and migration config
# Set ownership to appuser so the process can read its own files
COPY --chown=appuser:appgroup src/ /app/src/
COPY --chown=appuser:appgroup alembic/ /app/alembic/
COPY --chown=appuser:appgroup alembic.ini /app/

# Environment
ENV PYTHONPATH="/app/src"
ENV ENVIRONMENT="PROD"
# Ensure Python output is not buffered (critical for log streaming in K8s)
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

# FIXED: Drop to non-root user before executing the server.
# The Kubernetes securityContext (runAsNonRoot: true, runAsUser: 1001) in
# the Helm deployment template is now consistent with the Dockerfile user.
USER appuser

# FIXED: Removed `alembic upgrade head &&` from CMD.
# Database migrations are now exclusively managed by the Helm pre-install Job
# (db-migration-job.yaml). Running migrations in CMD caused a race condition:
# multiple pod replicas would simultaneously attempt schema migrations on startup,
# risking table locks and data corruption.
CMD ["python", "-m", "uvicorn", "suspensionlab.backend.api.main:app", \
     "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
