# ==============================================================================
# SuspensionLab PRO — 7-Day Trial Environment Configuration Template
# ==============================================================================
# SECURITY NOTICE:
# 1. Never reuse development keys or passwords here.
# 2. Every cryptographic key MUST be at least 32 characters long.
# 3. Running `python scripts/run_trial_environment.py` will auto-generate
#    a hardened `.env.trial` with random high-entropy keys if not present.
# ==============================================================================

# Runtime Environment
ENVIRONMENT=TRIAL

# Customer-Facing External URL (Must match your HTTPS tunnel or public hostname)
TRIAL_EXTERNAL_URL=https://trial.suspensionlab.com

# PostgreSQL Credentials (Isolated container network only, no host port exposed)
TRIAL_POSTGRES_USER=trial_admin
TRIAL_POSTGRES_PASSWORD=replace_with_openssl_rand_hex_32

# Redis Auth (Isolated container network only, no host port exposed)
TRIAL_REDIS_PASSWORD=replace_with_openssl_rand_hex_32

# Cryptographic Token & API Secrets (Must be at least 32 random characters)
TRIAL_JWT_SECRET=replace_with_openssl_rand_hex_32
TRIAL_API_KEY=sk_trial_replace_with_openssl_rand_hex_32

# Metrics & Observability Auth
TRIAL_METRICS_USER=trial_monitor
TRIAL_METRICS_PASS=replace_with_openssl_rand_hex_32

# Optional: Cloudflare Named Tunnel Token (for official trial.suspensionlab.com)
# Leave blank to use free ephemeral TryCloudflare quick tunnel
TUNNEL_TOKEN=
